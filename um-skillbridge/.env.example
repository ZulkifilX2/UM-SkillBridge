# ==============================================================================
# UM SkillBridge — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production deployment.
# NEVER commit your actual service role key or production secrets to Git.

# Supabase Public Configuration (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (Never expose to browser)
# Used only by admin migrations, backend triggers, or secured server actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL
# Local: http://localhost:3000
# Production: https://your-skillbridge-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
